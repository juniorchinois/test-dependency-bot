{
  "name": "@juniorchinois/depscan",
  "version": "1.0.6",
  "description": "GitHub bot to check for vulnerable dependencies",
  "main": "src/index.js",
  "bin": {
    "depscan": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./scanners": "./src/scanners/index.js",
    "./config": "./src/config.js"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "scripts": {
    "start": "probot run ./src/index.js",
    "dev": "probot run ./src/index.js --local",
    "test": "jest --coverage --setupFilesAfterEnv ./tests/setup.js",
    "test:unit": "jest tests/unit --setupFilesAfterEnv ./tests/setup.js",
    "test:integration": "jest tests/integration --setupFilesAfterEnv ./tests/setup.js",
    "prepublishOnly": "npm run build",
    "build": "echo '✅ Build complete'",
    "clear-cache": "node scripts/clear-cache.js",
    "setup": "node scripts/setup.js",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "format": "prettier --write src/**/*.js tests/**/*.js"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^12.0.0",
    "dotenv": "^16.3.1",
    "probot": "^12.3.0",
    "semver": "^7.5.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "nock": "^13.3.8",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}